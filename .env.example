# ==========================================
# ASHLEY 1.0 - CONFIGURACAO MULTIMODAL
# ==========================================

# Coloque a chave real somente no arquivo .env
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelos
GEMINI_CHAT_MODELS=gemini-3.8-flash
GEMINI_FILE_MODELS=gemini-3.8-flash
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image
GEMINI_VIDEO_MODELS=veo-3.1-generate-preview
GEMINI_TTS_MODELS=gemini-3.8-flash-tts

# Uploads
MAX_UPLOAD_MB=50
KEEP_UPLOADS=0

# Video
VIDEO_TIMEOUT_SECONDS=600

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://mrcfap.github.io
